# ============================================
# App
# ============================================
NODE_ENV=production

# URL pública donde queda expuesta la app (la que asigna Render, o tu dominio)
BASE_URL=https://tu-app.onrender.com

ADMIN_PASSWORD=cambia-esto
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# ============================================
# Base de datos (Supabase Postgres)
# ============================================
# Connection string "pooled" (puerto 6543, modo transaction) para runtime de la app.
# Project Settings -> Database -> Connection string -> Transaction pooler
DATABASE_URL="postgresql://postgres.xxxxxxxx:PASSWORD@aws-0-xx-xxxx-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Connection string directa (puerto 5432), usada solo por Prisma (prisma db push)
# para aplicar cambios de esquema. Project Settings -> Database -> Connection
# string -> Direct connection
DIRECT_URL="postgresql://postgres:PASSWORD@db.xxxxxxxx.supabase.co:5432/postgres"

# ============================================
# Almacenamiento de objetos (Supabase Storage, API S3-compatible)
# Storage -> ... -> S3 Access Keys, en el dashboard de Supabase
# ============================================
S3_ENDPOINT="https://xxxxxxxx.supabase.co/storage/v1/s3"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="xxxxxxxxxxxxxxxxxxxx"
S3_SECRET_ACCESS_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Base pública para construir URLs directas a objetos del bucket "asset-photos"
# marcado como público (fotos, códigos QR/barcode). Formato fijo de Supabase:
S3_PUBLIC_URL="https://xxxxxxxx.supabase.co/storage/v1/object/public"
