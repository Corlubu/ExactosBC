// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================
// ENUMS (NUEVO: Para integridad de datos NIIF)
// ============================================

enum RevaluationType {
  REVALUATION_SURPLUS  // Aumento de valor (NIC 16)
  IMPAIRMENT_LOSS      // Deterioro (NIC 36)
  REVERSAL_IMPAIRMENT  // Reversión de deterioro
}

// ============================================
// MULTI-TENANCY & AUTHENTICATION
// ============================================

model Company {
  id        Int      @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now())

  logoUrl     String?
  brandColor  String?

  defaultCurrency  String  @default("USD")
  defaultTimezone  String?
  defaultLanguage  String  @default("en")

  emailNotificationsEnabled Boolean @default(true)
  notificationEmail         String?
  apiKey                    String? @unique
  barcodeLabelConfig        String? @db.Text

  users               User[]
  roles               Role[]
  assets              Asset[]
  locations           Location[]
  maintenanceRecords  MaintenanceRecord[]
  workOrders          WorkOrder[]
  inventoryProcesses  InventoryProcess[]
  auditLogs           AuditLog[]
  alertSettings       AlertSetting[]
  assetAlerts         AssetAlert[]
  branches            Branch[]
  departments         Department[]
  assetTypes          AssetType[]
  assetClasses        AssetClass[]
  assetSubclasses     AssetSubclass[]

  // RELACIÓN NUEVA: Cierres contables
  monthlyClosures     MonthlyBalanceClosure[]
}

model Branch {
  id        Int      @id @default(autoincrement())
  name      String
  code      String
  address   String?
  qrCodeUrl String?
  createdAt DateTime @default(now())

  companyId Int
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  departments Department[]
  assets      Asset[]
  locations   Location[]
  users       User[]       @relation("UserBranch")

  @@unique([code, companyId])
  @@index([companyId])
}

model Department {
  id        Int      @id @default(autoincrement())
  name      String
  code      String
  qrCodeUrl String?
  createdAt DateTime @default(now())

  companyId Int
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  branchId Int
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  departmentHeadId Int?
  departmentHead   User? @relation("DepartmentHead", fields: [departmentHeadId], references: [id], onDelete: SetNull)

  assets    Asset[]
  locations Location[]
  users     User[]     @relation("UserDepartment")

  @@unique([code, branchId])
  @@index([companyId])
  @@index([branchId])
  @@index([departmentHeadId])
}

model AssetType {
  id                Int      @id @default(autoincrement())
  name              String
  code              String
  acronym           String?
  isDepreciable     Boolean  @default(true)
  accountingAccount String?
  createdAt         DateTime @default(now())

  companyId Int
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  assets       Asset[]
  assetClasses AssetClass[]

  @@unique([code, companyId])
  @@index([companyId])
}

model AssetClass {
  id                Int      @id @default(autoincrement())
  code              String
  description       String
  accountingAccount String?
  budgetCode        String?
  createdAt         DateTime @default(now())

  assetTypeId Int
  assetType   AssetType @relation(fields: [assetTypeId], references: [id], onDelete: Cascade)

  companyId Int
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  assetSubclasses AssetSubclass[]
  assets          Asset[]

  @@unique([code, assetTypeId])
  @@index([companyId])
  @@index([assetTypeId])
}

model AssetSubclass {
  id           Int      @id @default(autoincrement())
  description  String
  abbreviation String?
  createdAt    DateTime @default(now())

  classId Int
  class   AssetClass @relation(fields: [classId], references: [id], onDelete: Cascade)

  companyId Int
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  assets Asset[]

  @@index([companyId])
  @@index([classId])
}

model User {
  id           Int      @id @default(autoincrement())
  email        String
  passwordHash String
  firstName    String
  lastName     String
  createdAt    DateTime @default(now())
  isActive     Boolean  @default(true)

  position             String?
  identificationNumber String?
  qrCodeUrl            String?

  companyId Int
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  roleId Int?
  role   Role? @relation(fields: [roleId], references: [id], onDelete: SetNull)

  branchId Int?
  branch   Branch? @relation("UserBranch", fields: [branchId], references: [id], onDelete: SetNull)

  departmentId Int?
  department   Department? @relation("UserDepartment", fields: [departmentId], references: [id], onDelete: SetNull)

  assignedAssets         AssetAssignment[]
  assignedAssetsDirectly Asset[]           @relation("AssignedAssets")
  createdAuditLogs       AuditLog[]        @relation("CreatedBy")
  workOrdersCreated      WorkOrder[]       @relation("CreatedBy")
  workOrdersAssigned     WorkOrder[]       @relation("AssignedTo")
  movementsFrom          AssetMovement[]   @relation("MovementsFrom")
  movementsTo            AssetMovement[]   @relation("MovementsTo")
  enteredAssets          Asset[]           @relation("EnteredBy")
  departmentsHeaded      Department[]      @relation("DepartmentHead")

  approvedRevaluations   AssetRevaluation[] @relation("ApprovedBy")
  recordedUsageLogs      AssetUsageLog[]    @relation("RecordedBy")

  @@unique([email, companyId])
  @@unique([identificationNumber, companyId])
  @@index([companyId])
  @@index([branchId])
  @@index([departmentId])
}

model Role {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  createdAt   DateTime @default(now())

  companyId Int
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  users       User[]
  permissions RolePermission[]

  @@unique([name, companyId])
  @@index([companyId])
}

model Permission {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  category    String

  roles RolePermission[]
}

model RolePermission {
  id Int @id @default(autoincrement())

  roleId Int
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  permissionId Int
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

// ============================================
// ASSETS & LIFECYCLE
// ============================================

model Asset {
  id          Int      @id @default(autoincrement())
  assetTag    String
  name        String
  description String?
  category    String

  acquisitionCost    Float
  currentValue       Float
  residualValue      Float    @default(0)
  acquisitionDate    DateTime
  serviceDate        DateTime?
  supplier              String?
  purchaseDocument      String?
  supplierSerialNumber  String?
  unitCost              Float?
  quantity              Int?     @default(1)
  currency              String?  @default("USD")

  depreciationMethod String   @default("STRAIGHT_LINE")
  usefulLifeYears    Int?
  usefulLifeUnits    Int?
  currentUnits       Int?     @default(0)
  convention         String   @default("HALF_YEAR")

  depreciationPercentage Float?
  depreciationStartDate  DateTime?

  accountingAssetAccount            String?
  accumulatedDepreciationAccount    String?
  depreciationExpenseAccount        String?
  fixedAssetLedger                  String?

  classCode       String?
  costCenterCode  String?
  areaCode        String?
  subareaCode     String?
  branchCode      String?

  activityProject String?
  observations    String?

  branchId    Int?
  branch      Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  departmentId Int?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  assetTypeId Int?
  assetType   AssetType? @relation(fields: [assetTypeId], references: [id], onDelete: SetNull)

  assetClassId Int?
  assetClass   AssetClass? @relation(fields: [assetClassId], references: [id], onDelete: SetNull)

  assetSubclassId Int?
  assetSubclass   AssetSubclass? @relation(fields: [assetSubclassId], references: [id], onDelete: SetNull)

  enteredById Int?
  enteredBy   User? @relation("EnteredBy", fields: [enteredById], references: [id], onDelete: SetNull)

  seriesNumber  String?
  invoiceNumber String?

  status        String   @default("ACTIVE")
  disposalDate  DateTime?
  disposalValue Float?

  serialNumber  String?
  manufacturer  String?
  model         String?
  photoUrl      String?
  qrCodeUrl     String?
  createdAt DateTime @default(now())

  companyId Int
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  locationId Int?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  assignedToUserId Int?
  assignedToUser   User? @relation("AssignedAssets", fields: [assignedToUserId], references: [id], onDelete: SetNull)

  assignments            AssetAssignment[]
  maintenanceRecords     MaintenanceRecord[]
  depreciationCalculations DepreciationCalculation[]
  auditLogs              AuditLog[]
  attachments            AssetAttachment[]
  alerts                 AssetAlert[]
  movements              AssetMovement[]

  // RELATIONS FOR VALUATION & ACCOUNTING
  components             AssetComponent[]
  revaluations           AssetRevaluation[]
  usageLogs              AssetUsageLog[]
  depreciationBooks      DepreciationBook[]
  monthlyBalances        MonthlyBalanceClosure[] // NUEVO

  @@unique([assetTag, companyId])

  // NUEVOS ÍNDICES DE RENDIMIENTO PARA BÚSQUEDAS FRECUENTES
  @@index([assetTag])
  @@index([serialNumber])
  @@index([companyId])
  @@index([locationId])
  @@index([status])
  @@index([assignedToUserId])
  @@index([branchId])
  @@index([departmentId])
  @@index([assetTypeId])
  @@index([assetClassId])
  @@index([assetSubclassId])
  @@index([enteredById])
}

// ============================================
// VALUATION, COMPONENTS & USAGE
// ============================================

model AssetComponent {
  id                 Int      @id @default(autoincrement())
  name               String
  description        String?
  cost               Float
  usefulLifeYears    Int?
  residualValue      Float    @default(0)
  currentValue            Float    // Valor actual del componente
  accumulatedDepreciation Float    @default(0)

  createdAt          DateTime @default(now())

  assetId            Int
  asset              Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)

// Relación con los cierres mensuales específicos del componente
  monthlyBalances    MonthlyBalanceClosure[]

  @@index([assetId])
}

model AssetRevaluation {
  id                 Int      @id @default(autoincrement())
  date               DateTime @default(now())
  previousValue      Float
  newValue           Float

  // NUEVOS CAMPOS DE INTEGRIDAD NIIF
  type               RevaluationType @default(REVALUATION_SURPLUS)
  impactsPAndL       Boolean         @default(false) // Si es True impacta P&G (NIC 36), False impacta Patrimonio (NIC 16)
  reason             String          // Motivo breve
  legalJustification String?         @db.Text // Texto largo para explicar el motivo técnico/legal
  documentRef        String?         // Referencia al peritaje físico

  assetId            Int
  asset              Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)

  approvedById       Int?
  approvedBy         User?    @relation("ApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([assetId])
  @@index([approvedById])
  @@index([type]) // Índice por tipo de revaluación
}

model AssetUsageLog {
  id                 Int      @id @default(autoincrement())
  date               DateTime @default(now())
  unitsAdded         Int
  totalUnits         Int
  notes              String?

  assetId            Int
  asset              Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)

  recordedById       Int?
  recordedBy         User?    @relation("RecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([assetId])
  @@index([recordedById])
}

model DepreciationBook {
  id                 Int      @id @default(autoincrement())
  name               String
  method             String
  usefulLifeYears    Int
  residualValue      Float    @default(0)

  assetId            Int
  asset              Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
}

// ============================================
// NUEVA TABLA: CIERRES CONTABLES (MONTHLY BALANCES)
// ============================================

model MonthlyBalanceClosure {
  id                      Int      @id @default(autoincrement())
  year                    Int      // Ej: 2024
  month                   Int      // Ej: 12 (Diciembre)
  closureDate             DateTime @default(now())

  acquisitionCost         Float    // Costo histórico al cierre de ese mes
  currentValue            Float    // Valor neto en libros al cierre
  accumulatedDepreciation Float    // Depreciación acumulada total hasta esa fecha
  monthlyDepreciation     Float    // Gasto de depreciación de ese mes específico

  assetId                 Int
  asset                   Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)

  // --- NUEVA RELACIÓN OPCIONAL ---
  // Si es null, el cierre es para un activo sin componentes.
  // Si tiene valor, es el cierre específico de ese componente.
  componentId             Int?
  component               AssetComponent? @relation(fields: [componentId], references: [id], onDelete: SetNull)
  // -------------------------------

  companyId               Int
  company                 Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // AJUSTE CRÍTICO: La unicidad ahora incluye al componente
  @@unique([assetId, componentId, year, month])

  @@index([companyId, year, month])
  @@index([assetId])
  @@index([componentId])
}

// ============================================
// ATTACHMENTS & ASSIGNMENTS
// ============================================

model AssetAttachment {
  id          Int      @id @default(autoincrement())
  fileName    String
  fileUrl     String
  fileType    String
  description String?
  createdAt   DateTime @default(now())

  assetId Int
  asset   Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@index([fileType])
}

model Location {
  id          Int      @id @default(autoincrement())
  name        String
  type        String
  address     String?
  latitude    Float?
  longitude   Float?
  parentId    Int?
  qrCodeUrl   String?
  createdAt   DateTime @default(now())

  companyId Int
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  branchId Int?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  departmentId Int?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  assets             Asset[]
  inventoryProcesses InventoryProcess[]
  movementsFrom      AssetMovement[]    @relation("MovementsFrom")
  movementsTo        AssetMovement[]    @relation("MovementsTo")

  @@index([companyId])
  @@index([parentId])
  @@index([branchId])
  @@index([departmentId])
}

model AssetAssignment {
  id          Int      @id @default(autoincrement())
  startDate   DateTime @default(now())
  endDate     DateTime?
  notes       String?

  briefDescription       String?
  fixedAssetCode         String?
  initialCondition       String?
  maintenanceObligations String?

  assetId Int
  asset   Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@index([userId])
}

// ============================================
// DEPRECIATION, MAINTENANCE, INVENTORY & AUDIT
// ============================================

model DepreciationCalculation {
  id                Int      @id @default(autoincrement())
  calculationDate   DateTime @default(now())
  periodStartDate   DateTime
  periodEndDate     DateTime
  depreciationAmount Float
  accumulatedDepreciation Float
  bookValue         Float
  method            String

  assetId Int
  asset   Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@index([calculationDate])
}

model MaintenanceRecord {
  id              Int      @id @default(autoincrement())
  type            String
  description     String
  cost            Float    @default(0)
  performedDate   DateTime
  nextDueDate     DateTime?
  notes           String?

  assetId Int
  asset   Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  companyId Int
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  workOrderId Int?
  workOrder   WorkOrder? @relation(fields: [workOrderId], references: [id], onDelete: SetNull)

  @@index([assetId])
  @@index([companyId])
  @@index([workOrderId])
}

model WorkOrder {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  priority    String   @default("MEDIUM")
  status      String   @default("OPEN")
  createdAt   DateTime @default(now())
  dueDate     DateTime?
  completedAt DateTime?
  estimatedCost Float?
  actualCost    Float?

  companyId Int
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdById Int
  createdBy   User @relation("CreatedBy", fields: [createdById], references: [id], onDelete: Cascade)

  assignedToId Int?
  assignedTo   User? @relation("AssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)

  maintenanceRecords MaintenanceRecord[]

  @@index([companyId])
  @@index([createdById])
  @@index([assignedToId])
  @@index([status])
}

model InventoryProcess {
  id          Int      @id @default(autoincrement())
  type        String
  status      String   @default("IN_PROGRESS")
  startDate   DateTime @default(now())
  endDate     DateTime?
  notes       String?

  companyId Int
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  locationId Int?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  movements AssetMovement[]

  @@index([companyId])
  @@index([locationId])
  @@index([status])
}

model AssetMovement {
  id Int @id @default(autoincrement())

  processId Int
  process InventoryProcess @relation(fields: [processId], references: [id], onDelete: Cascade)

  assetId Int
  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  fromLocationId Int?
  fromLocation Location? @relation("MovementsFrom", fields: [fromLocationId], references: [id], onDelete: SetNull)

  fromUserId Int?
  fromUser User? @relation("MovementsFrom", fields: [fromUserId], references: [id], onDelete: SetNull)

  toLocationId Int?
  toLocation Location? @relation("MovementsTo", fields: [toLocationId], references: [id], onDelete: SetNull)

  toUserId Int?
  toUser User? @relation("MovementsTo", fields: [toUserId], references: [id], onDelete: SetNull)

  previousStatus String?
  newStatus String?
  notes String?
  movementDate DateTime @default(now())

  @@index([processId])
  @@index([assetId])
  @@index([fromLocationId])
  @@index([toLocationId])
  @@index([fromUserId])
  @@index([toUserId])
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  action      String
  entityType  String
  entityId    Int
  oldValues   String?
  newValues   String?
  timestamp   DateTime @default(now())
  ipAddress   String?

  companyId Int
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  userId Int
  user   User @relation("CreatedBy", fields: [userId], references: [id], onDelete: Cascade)

  assetId Int?
  asset   Asset? @relation(fields: [assetId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([userId])
  @@index([assetId])
  @@index([timestamp])
  @@index([entityType])
}

model AlertSetting {
  id          Int      @id @default(autoincrement())
  name        String
  alertType   String
  isEnabled   Boolean  @default(true)

  thresholdPercentage Float?
  thresholdAmount     Float?
  assetCategory       String?
  notifyUsers         Boolean @default(true)

  createdAt   DateTime @default(now())

  companyId Int
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  triggeredAlerts AssetAlert[]

  @@index([companyId])
  @@index([isEnabled])
  @@index([alertType])
}

model AssetAlert {
  id              Int      @id @default(autoincrement())
  alertType       String
  status          String   @default("ACTIVE")
  message         String

  currentValue    Float
  thresholdValue  Float?
  triggeredAt     DateTime @default(now())
  acknowledgedAt  DateTime?

  companyId Int
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  assetId Int
  asset   Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  alertSettingId Int?
  alertSetting   AlertSetting? @relation(fields: [alertSettingId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([assetId])
  @@index([status])
  @@index([triggeredAt])
  @@index([alertSettingId])
}
