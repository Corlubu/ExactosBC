// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = "postgresql://postgres:postgres@postgres/app" // hardcoded because it's an internal docker connection
}

// ============================================
// MULTI-TENANCY & AUTHENTICATION
// ============================================

model Company {
  id        Int      @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now())
  
  // Branding
  logoUrl     String? // MinIO URL for company logo
  brandColor  String? // Hex color code for branding (e.g., #3B82F6)
  
  // Regional Settings
  defaultCurrency  String  @default("USD")
  defaultTimezone  String? // IANA timezone (e.g., America/New_York)
  defaultLanguage  String  @default("en") // ISO language code (e.g., en, es, fr)
  
  // Email Notifications
  emailNotificationsEnabled Boolean @default(true)
  notificationEmail         String? // Email for system notifications
  
  // API Access
  apiKey String? @unique // API key for integrations
  
  // Barcode Label Configuration
  barcodeLabelConfig String? @db.Text // JSON configuration for barcode label printing
  
  // Relations
  users               User[]
  roles               Role[]
  assets              Asset[]
  locations           Location[]
  maintenanceRecords  MaintenanceRecord[]
  workOrders          WorkOrder[]
  inventoryProcesses  InventoryProcess[]
  auditLogs           AuditLog[]
  alertSettings       AlertSetting[]
  assetAlerts         AssetAlert[]
  branches            Branch[]
  departments         Department[]
  assetTypes          AssetType[]
  assetClasses        AssetClass[]
  assetSubclasses     AssetSubclass[]
}

model Branch {
  id        Int      @id @default(autoincrement())
  name      String
  code      String   // Numerical code for the branch (e.g., "01", "02")
  address   String?  // Physical address of the branch
  qrCodeUrl String?  // Generated QR code for the branch
  createdAt DateTime @default(now())
  
  companyId Int
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  // Relations
  departments Department[]
  assets      Asset[]
  locations   Location[]
  users       User[]       @relation("UserBranch")
  
  @@unique([code, companyId])
  @@index([companyId])
}

model Department {
  id        Int      @id @default(autoincrement())
  name      String
  code      String   // Numerical code for the department (e.g., "01", "02")
  qrCodeUrl String?  // Generated QR code for the department
  createdAt DateTime @default(now())
  
  companyId Int
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  branchId Int
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  
  departmentHeadId Int?
  departmentHead   User? @relation("DepartmentHead", fields: [departmentHeadId], references: [id], onDelete: SetNull)
  
  // Relations
  assets    Asset[]
  locations Location[]
  users     User[]     @relation("UserDepartment")
  
  @@unique([code, branchId])
  @@index([companyId])
  @@index([branchId])
  @@index([departmentHeadId])
}

model AssetType {
  id                Int      @id @default(autoincrement())
  name              String   // e.g., "Machinery and equipment", "Furniture", "Technological equipment", "Vehicles"
  code              String   // Numerical code for the asset type (e.g., "01", "02", "03", "04")
  acronym           String?  // Short acronym for the asset type (e.g., "MACH", "FURN", "TECH", "VEH")
  isDepreciable     Boolean  @default(true) // Whether assets of this type are depreciable
  accountingAccount String?  // Accounting account number for this asset type
  createdAt         DateTime @default(now())
  
  companyId Int
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  // Relations
  assets       Asset[]
  assetClasses AssetClass[]
  
  @@unique([code, companyId])
  @@index([companyId])
}

model AssetClass {
  id                Int      @id @default(autoincrement())
  code              String   // Code for the asset class
  description       String   // Description of the asset class
  accountingAccount String?  // Accounting account for this class
  budgetCode        String?  // Budget code for this class
  createdAt         DateTime @default(now())
  
  assetTypeId Int
  assetType   AssetType @relation(fields: [assetTypeId], references: [id], onDelete: Cascade)
  
  companyId Int
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  // Relations
  assetSubclasses AssetSubclass[]
  assets          Asset[]
  
  @@unique([code, assetTypeId])
  @@index([companyId])
  @@index([assetTypeId])
}

model AssetSubclass {
  id           Int      @id @default(autoincrement())
  description  String   // Description of the asset subclass
  abbreviation String?  // Short abbreviation for the subclass
  createdAt    DateTime @default(now())
  
  classId Int
  class   AssetClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  
  companyId Int
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  // Relations
  assets Asset[]
  
  @@index([companyId])
  @@index([classId])
}

model User {
  id           Int      @id @default(autoincrement())
  email        String
  passwordHash String
  firstName    String
  lastName     String
  createdAt    DateTime @default(now())
  isActive     Boolean  @default(true)
  
  // Custodian Information
  position             String? // Job title or position
  identificationNumber String? // Employee identification number
  qrCodeUrl            String? // Generated QR code for the custodian
  
  companyId Int
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  roleId Int?
  role   Role? @relation(fields: [roleId], references: [id], onDelete: SetNull)
  
  // Organizational assignment for custodians
  branchId Int?
  branch   Branch? @relation("UserBranch", fields: [branchId], references: [id], onDelete: SetNull)
  
  departmentId Int?
  department   Department? @relation("UserDepartment", fields: [departmentId], references: [id], onDelete: SetNull)
  
  // Relations
  assignedAssets         AssetAssignment[]
  assignedAssetsDirectly Asset[]           @relation("AssignedAssets")
  createdAuditLogs       AuditLog[]        @relation("CreatedBy")
  workOrdersCreated      WorkOrder[]       @relation("CreatedBy")
  workOrdersAssigned     WorkOrder[]       @relation("AssignedTo")
  movementsFrom          AssetMovement[]   @relation("MovementsFrom")
  movementsTo            AssetMovement[]   @relation("MovementsTo")
  enteredAssets          Asset[]           @relation("EnteredBy")
  departmentsHeaded      Department[]      @relation("DepartmentHead")
  
  @@unique([email, companyId])
  @@unique([identificationNumber, companyId])
  @@index([companyId])
  @@index([branchId])
  @@index([departmentId])
}

model Role {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  createdAt   DateTime @default(now())
  
  companyId Int
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  // Relations
  users       User[]
  permissions RolePermission[]
  
  @@unique([name, companyId])
  @@index([companyId])
}

model Permission {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  category    String // e.g., "assets", "finance", "maintenance", "inventory"
  
  // Relations
  roles RolePermission[]
}

model RolePermission {
  id Int @id @default(autoincrement())
  
  roleId Int
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  
  permissionId Int
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  
  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

// ============================================
// ASSETS & LIFECYCLE
// ============================================

model Asset {
  id          Int      @id @default(autoincrement())
  assetTag    String // Unique identifier/barcode
  name        String
  description String?
  category    String // e.g., "IT Equipment", "Furniture", "Vehicles"
  
  // Financial Information
  acquisitionCost    Float
  currentValue       Float
  residualValue      Float    @default(0)
  acquisitionDate    DateTime
  serviceDate        DateTime? // Date put into service
  
  // Supplier & Purchase Information
  supplier              String?
  purchaseDocument      String? // Invoice number, contract reference, etc.
  supplierSerialNumber  String?
  unitCost              Float?
  quantity              Int?     @default(1)
  currency              String?  @default("USD")
  
  // Depreciation Settings
  depreciationMethod String   @default("STRAIGHT_LINE") // STRAIGHT_LINE, DECLINING_BALANCE, UNITS_OF_PRODUCTION, SUM_OF_YEARS_DIGITS
  usefulLifeYears    Int?
  usefulLifeUnits    Int? // For units of production method
  currentUnits       Int?     @default(0) // Current usage units
  convention         String   @default("HALF_YEAR") // HALF_YEAR, FULL_YEAR, MID_MONTH
  
  // Depreciation Details (Extended)
  depreciationPercentage Float?
  depreciationStartDate  DateTime?
  
  // Accounting Information
  accountingAssetAccount            String? // Asset account number
  accumulatedDepreciationAccount    String? // Accumulated depreciation account
  depreciationExpenseAccount        String? // Depreciation expense account
  fixedAssetLedger                  String? // Ledger or module reference
  
  // Organizational Structure Codes
  classCode       String? // Asset type/class code (e.g., VEH for vehicles, COMP for computers)
  costCenterCode  String? // Cost center code
  areaCode        String? // Area code
  subareaCode     String? // Subarea code
  branchCode      String? // Branch code
  
  // Activity & Project Tracking
  activityProject String? // Project or activity link
  
  // Additional Information
  observations    String? // Additional notes, special conditions, guarantees, restrictions
  
  // New organizational structure (replaces string codes with proper relations)
  branchId    Int?
  branch      Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
  
  departmentId Int?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  
  assetTypeId Int?
  assetType   AssetType? @relation(fields: [assetTypeId], references: [id], onDelete: SetNull)
  
  assetClassId Int?
  assetClass   AssetClass? @relation(fields: [assetClassId], references: [id], onDelete: SetNull)
  
  assetSubclassId Int?
  assetSubclass   AssetSubclass? @relation(fields: [assetSubclassId], references: [id], onDelete: SetNull)
  
  // User who entered the asset into the system
  enteredById Int?
  enteredBy   User? @relation("EnteredBy", fields: [enteredById], references: [id], onDelete: SetNull)
  
  // Additional physical identification
  seriesNumber  String? // Series number (separate from serialNumber)
  invoiceNumber String? // Invoice number (in addition to purchaseDocument)
  
  // Component information
  component1 String? // Component 1 description
  component2 String? // Component 2 description
  component3 String? // Component 3 description
  
  // Status & Location
  status        String   @default("ACTIVE") // ACTIVE, IN_REPAIR, DISPOSED, STOLEN, LOST
  disposalDate  DateTime?
  disposalValue Float?
  
  // Physical Information
  serialNumber  String?
  manufacturer  String?
  model         String?
  
  // Digital Records
  photoUrl      String? // MinIO URL
  qrCodeUrl     String? // Generated QR code for scanning
  
  // Metadata
  createdAt DateTime @default(now())
  
  companyId Int
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  locationId Int?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  
  // User Assignment (for quick access to currently assigned user)
  assignedToUserId Int?
  assignedToUser   User? @relation("AssignedAssets", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  
  // Relations
  assignments            AssetAssignment[]
  maintenanceRecords     MaintenanceRecord[]
  depreciationCalculations DepreciationCalculation[]
  auditLogs              AuditLog[]
  attachments            AssetAttachment[]
  alerts                 AssetAlert[]
  movements              AssetMovement[]
  
  @@unique([assetTag, companyId])
  @@index([companyId])
  @@index([locationId])
  @@index([status])
  @@index([assignedToUserId])
  @@index([branchId])
  @@index([departmentId])
  @@index([assetTypeId])
  @@index([assetClassId])
  @@index([assetSubclassId])
  @@index([enteredById])
}

model AssetAttachment {
  id          Int      @id @default(autoincrement())
  fileName    String
  fileUrl     String   // MinIO URL
  fileType    String   // e.g., 'PHOTO', 'INVOICE', 'CONTRACT', 'INSURANCE_POLICY', 'WARRANTY', 'OTHER'
  description String?  // Optional description of the attachment
  createdAt   DateTime @default(now())
  
  assetId Int
  asset   Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  
  @@index([assetId])
  @@index([fileType])
}

model Location {
  id          Int      @id @default(autoincrement())
  name        String
  type        String   // WAREHOUSE, OFFICE, BUILDING, ROOM, etc.
  address     String?
  latitude    Float?
  longitude   Float?
  parentId    Int?     // For hierarchical locations
  qrCodeUrl   String?  // Generated QR code for the location
  createdAt   DateTime @default(now())
  
  companyId Int
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  // Link to organizational structure
  branchId Int?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
  
  departmentId Int?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  
  // Relations
  assets             Asset[]
  inventoryProcesses InventoryProcess[]
  movementsFrom      AssetMovement[]    @relation("MovementsFrom")
  movementsTo        AssetMovement[]    @relation("MovementsTo")
  
  @@index([companyId])
  @@index([parentId])
  @@index([branchId])
  @@index([departmentId])
}

model AssetAssignment {
  id          Int      @id @default(autoincrement())
  startDate   DateTime @default(now())
  endDate     DateTime?
  notes       String?
  
  briefDescription       String? // Brief description of the asset for custody purposes
  fixedAssetCode         String? // Fixed asset code or plate number
  initialCondition       String? // Initial condition of the asset when assigned
  maintenanceObligations String? // Maintenance obligations and conditions of use
  
  assetId Int
  asset   Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  
  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([assetId])
  @@index([userId])
}

// ============================================
// DEPRECIATION & FINANCE
// ============================================

model DepreciationCalculation {
  id                Int      @id @default(autoincrement())
  calculationDate   DateTime @default(now())
  periodStartDate   DateTime
  periodEndDate     DateTime
  depreciationAmount Float
  accumulatedDepreciation Float
  bookValue         Float
  method            String
  
  assetId Int
  asset   Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  
  @@index([assetId])
  @@index([calculationDate])
}

// ============================================
// MAINTENANCE
// ============================================

model MaintenanceRecord {
  id              Int      @id @default(autoincrement())
  type            String // PREVENTIVE, CORRECTIVE, INSPECTION
  description     String
  cost            Float    @default(0)
  performedDate   DateTime
  nextDueDate     DateTime?
  notes           String?
  
  assetId Int
  asset   Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  
  companyId Int
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  workOrderId Int?
  workOrder   WorkOrder? @relation(fields: [workOrderId], references: [id], onDelete: SetNull)
  
  @@index([assetId])
  @@index([companyId])
  @@index([workOrderId])
}

model WorkOrder {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  priority    String   @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  status      String   @default("OPEN") // OPEN, IN_PROGRESS, COMPLETED, CANCELLED
  createdAt   DateTime @default(now())
  dueDate     DateTime?
  completedAt DateTime?
  estimatedCost Float?
  actualCost    Float?
  
  companyId Int
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  createdById Int
  createdBy   User @relation("CreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  
  assignedToId Int?
  assignedTo   User? @relation("AssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  
  // Relations
  maintenanceRecords MaintenanceRecord[]
  
  @@index([companyId])
  @@index([createdById])
  @@index([assignedToId])
  @@index([status])
}

// ============================================
// INVENTORY & COUNTING
// ============================================

model InventoryProcess {
  id          Int      @id @default(autoincrement())
  type        String // INITIAL_LOAD, COUNTING, TRANSFER, RECEPTION
  status      String   @default("IN_PROGRESS") // IN_PROGRESS, COMPLETED, CANCELLED
  startDate   DateTime @default(now())
  endDate     DateTime?
  notes       String?
  
  companyId Int
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  locationId Int?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  
  // Relations
  movements AssetMovement[]
  
  @@index([companyId])
  @@index([locationId])
  @@index([status])
}

model AssetMovement {
  id Int @id @default(autoincrement())
  
  // Link to the inventory process (TRANSFER or RECEPTION)
  processId Int
  process InventoryProcess @relation(fields: [processId], references: [id], onDelete: Cascade)
  
  // Link to the asset being moved
  assetId Int
  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  
  // Source information
  fromLocationId Int?
  fromLocation Location? @relation("MovementsFrom", fields: [fromLocationId], references: [id], onDelete: SetNull)
  
  fromUserId Int?
  fromUser User? @relation("MovementsFrom", fields: [fromUserId], references: [id], onDelete: SetNull)
  
  // Destination information
  toLocationId Int?
  toLocation Location? @relation("MovementsTo", fields: [toLocationId], references: [id], onDelete: SetNull)
  
  toUserId Int?
  toUser User? @relation("MovementsTo", fields: [toUserId], references: [id], onDelete: SetNull)
  
  // Snapshot of asset state (for audit trail)
  previousStatus String?
  newStatus String?
  
  // Movement metadata
  notes String?
  movementDate DateTime @default(now())
  
  @@index([processId])
  @@index([assetId])
  @@index([fromLocationId])
  @@index([toLocationId])
  @@index([fromUserId])
  @@index([toUserId])
}

// ============================================
// AUDIT & COMPLIANCE
// ============================================

model AuditLog {
  id          Int      @id @default(autoincrement())
  action      String // CREATE, UPDATE, DELETE, TRANSFER, etc.
  entityType  String // ASSET, USER, LOCATION, etc.
  entityId    Int
  oldValues   String? // JSON
  newValues   String? // JSON
  timestamp   DateTime @default(now())
  ipAddress   String?
  
  companyId Int
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  userId Int
  user   User @relation("CreatedBy", fields: [userId], references: [id], onDelete: Cascade)
  
  assetId Int?
  asset   Asset? @relation(fields: [assetId], references: [id], onDelete: SetNull)
  
  @@index([companyId])
  @@index([userId])
  @@index([assetId])
  @@index([timestamp])
  @@index([entityType])
}

// ============================================
// ALERTS & NOTIFICATIONS
// ============================================

model AlertSetting {
  id          Int      @id @default(autoincrement())
  name        String   // User-friendly name for this alert rule
  alertType   String   // DEPRECIATION_MILESTONE, BOOK_VALUE_THRESHOLD, FULLY_DEPRECIATED
  isEnabled   Boolean  @default(true)
  
  // Threshold values (which one is used depends on alertType)
  thresholdPercentage Float?  // For DEPRECIATION_MILESTONE (e.g., 75 means alert at 75% depreciated)
  thresholdAmount     Float?  // For BOOK_VALUE_THRESHOLD (e.g., alert when book value < this amount)
  
  // Optional filters to limit which assets this applies to
  assetCategory       String? // If set, only applies to assets in this category
  
  // Notification settings
  notifyUsers         Boolean @default(true)  // Whether to create notifications for users
  
  createdAt   DateTime @default(now())
  
  companyId Int
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  // Relations
  triggeredAlerts AssetAlert[]
  
  @@index([companyId])
  @@index([isEnabled])
  @@index([alertType])
}

model AssetAlert {
  id              Int      @id @default(autoincrement())
  alertType       String   // DEPRECIATION_MILESTONE, BOOK_VALUE_THRESHOLD, FULLY_DEPRECIATED
  status          String   @default("ACTIVE") // ACTIVE, ACKNOWLEDGED, DISMISSED
  message         String   // Human-readable alert message
  
  // Alert context data
  currentValue    Float    // Book value or depreciation percentage at time of alert
  thresholdValue  Float?   // The threshold that was crossed
  
  triggeredAt     DateTime @default(now())
  acknowledgedAt  DateTime?
  
  companyId Int
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  assetId Int
  asset   Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  
  alertSettingId Int?
  alertSetting   AlertSetting? @relation(fields: [alertSettingId], references: [id], onDelete: SetNull)
  
  @@index([companyId])
  @@index([assetId])
  @@index([status])
  @@index([triggeredAt])
  @@index([alertSettingId])
}
